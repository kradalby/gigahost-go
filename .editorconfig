root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.go]
indent_style = tab

[{*.md,*.yml,*.yaml,*.json,*.jsonc,*.hujson,*.toml}]
indent_size = 2

[Makefile]
indent_style = tab

[*.nix]
indent_size = 2
